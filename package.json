{
  "name": "garfo",
  "version": "1.6.0",
  "description": "An Express API for studying and observing cycling data by Ameciclo, focused on promoting and improving cycling infrastructure and safety.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "test": "// Sem testes por enquanto",
    "test:connection": "node test-connection.js",
    "test:routes": "node test-routes.mjs",
    "test:routes:bash": "./test-routes.sh",
    "diagnose:routes": "node diagnose-routes.js",
    "docker:setup": "./dev-setup.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx watch -r dotenv/config db/seed.ts",
    "db:seed:opt": "tsx -r dotenv/config db/optimized-seed-runner.ts",
    "db:seed:status": "npm run db:seed:opt status",
    "db:seed:reset": "npm run db:seed:opt reset",
    "db:seed:resume": "npm run db:seed:opt resume",
    "setup:dev": "tsx -r dotenv/config setup-dev.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ameciclo/garfo.git"
  },
  "keywords": [
    "bycicle",
    "cyclist",
    "counting",
    "profile",
    "javascript",
    "express",
    "backend"
  ],
  "author": "Daniel Valença (Ameciclo)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Ameciclo/garfo/issues"
  },
  "homepage": "https://github.com/Ameciclo/garfo#readme",
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "@types/pg": "^8.11.14",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.44.4",
    "express": "^4.18.2",
    "fast-glob": "^3.3.3",
    "file-saver": "^2.0.5",
    "node-fetch": "^3.3.2",
    "osmtogeojson": "^3.0.0-beta.5",
    "pg": "^8.11.3",
    "postgres": "^3.4.3",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3"
  }
}
